{
  "manifest_version": 3,
  "name": "L站笔记导出 (Obsidian MD)",
  "version": "1.4.0",
  "description": "一键将 linux.do 主题导出为 Obsidian Markdown；图片可 base64 或上传 WebDAV",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 L站笔记导出侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://linux.do/*",
        "https://www.linux.do/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "sidePanel",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://linux.do/*",
    "https://www.linux.do/*",
    "https://*.linux.do/*",
    "https://*.ldstatic.com/*",
    "https://cdn.linux.do/*",
    "https://*.discourse-cdn.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "icons/*"
      ],
      "matches": [
        "https://linux.do/*",
        "https://www.linux.do/*"
      ]
    }
  ]
}
